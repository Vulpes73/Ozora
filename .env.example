# Kopieer dit bestand naar .env en vul je gegevens in:
# cp .env.example .env

# ── Anthropic API ─────────────────────────────────────────────
# Verplicht voor agent.py en mail_agent.py
ANTHROPIC_API_KEY=your_api_key_here

# ── Gmail (voor e-mail versturen) ─────────────────────────────
# Gebruik NIET je gewone Gmail-wachtwoord, maar een App Password.
# App Password aanmaken: https://myaccount.google.com/apppasswords
# (2-stapsverificatie moet aan staan)
GMAIL_ADDRESS=jouw.naam@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Ontvanger van de dagelijkse briefing (standaard: zelfde als GMAIL_ADDRESS)
RECIPIENT_EMAIL=jouw.naam@gmail.com

# ── WhatsApp via CallMeBot (voor urgente alerts) ───────────────
# Eenmalige setup:
#   1. Sla op in telefoon: +34 644 65 21 69  (naam: CallMeBot)
#   2. Stuur via WhatsApp: I allow callmebot to send me messages
#   3. Je ontvangt een API key — vul die hieronder in
#
# Telefoonnummer in internationaal formaat ZONDER + of 00
# Voorbeeld Nederland: 31612345678  (06-nummer zonder de eerste 0, met landcode 31)
CALLMEBOT_PHONE=316xxxxxxxx
CALLMEBOT_API_KEY=xxxxxxx
